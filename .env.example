# Augura 部署配置示例。复制为 .env 后按需修改；install 脚本会自动把
# 各密码替换为随机值。所有项在 docker-compose.yml 中均有默认值，不配也能跑。

POSTGRES_USER=augura
POSTGRES_PASSWORD=augura
POSTGRES_DB=augura

# Neo4j 浏览器（http://localhost:7474）的账密；两个键必须保持一致
NEO4J_AUTH=neo4j/augura123
NEO4J_PASSWORD=augura123

# MinIO 控制台（http://localhost:9001）root 账密 + 业务程序最小权限账号
MINIO_ROOT_USER=augura
MINIO_ROOT_PASSWORD=augura123
MINIO_APP_USER=augura-app
MINIO_APP_PASSWORD=changeme-app
MINIO_BUCKET=creative-assets

# AI 提供方（OpenAI 兼容接口）。可留空，装好后在 Web 的 Settings 页配置
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
